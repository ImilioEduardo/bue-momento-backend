NODE_ENV=development
PORT=3001

# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis (Upstash — plano fixo, não pay-per-command)
REDIS_URL=redis://default:password@host:6379

# JWT
JWT_ACCESS_SECRET=change_me_min_32_chars_access_secret_here__
JWT_REFRESH_SECRET=change_me_min_32_chars_refresh_secret_here_
JWT_GUEST_SECRET=change_me_min_32_chars_guest_secret_here___

# URLs
WEB_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# Cloudflare Stream (vídeo)
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_CUSTOMER_SUBDOMAIN=
STREAM_WEBHOOK_SECRET=
STREAM_REQUIRE_SIGNED=false

# Cloudflare R2 (fotos e ZIPs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Pagamentos
PAYMENT_PROVIDER=manual
PROXYPAY_API_KEY=
PROXYPAY_WEBHOOK_SECRET=

# Notificações
SMS_PROVIDER=console
SMS_API_KEY=
EMAIL_PROVIDER=console
EMAIL_API_KEY=

# Monitorização
SENTRY_DSN=

# Admin
ADMIN_SECRET=
